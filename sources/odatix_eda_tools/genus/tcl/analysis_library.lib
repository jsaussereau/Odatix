/*
 * Odatix - generic library of the RTL analysis
 *
 * Genus elaborates nothing without a library, and an analysis targets no
 * technology: when no technology setup script is there, analyze_script.tcl
 * reads this one. It only needs to exist, the design is not mapped onto it.
 */
library (odatix_analysis) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  default_cell_leakage_power : 0;
  default_fanout_load : 1;
  default_inout_pin_cap : 0.001;
  default_input_pin_cap : 0.001;
  default_output_pin_cap : 0;
  default_leakage_power_density : 0;
  default_max_transition : 1;
  in_place_swap_mode : match_footprint;
  cell (INV) {
    area : 1;
    cell_leakage_power : 0;
    pin (A) { direction : input; capacitance : 0.001; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (scalar) { values ("0.01"); }
        cell_fall (scalar) { values ("0.01"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
}
